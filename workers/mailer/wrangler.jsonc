{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/#schema",
  "name": "etxitsolutions-mailer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "FROM_ADDRESS": "notifications@etxitsolutions.com",
    "FROM_NAME": "ETX IT Solutions",
    "TO_ADDRESS": "contact@etxitsolutions.com"
  }
}
